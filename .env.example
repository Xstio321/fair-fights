# DAoC Fair Fights Tracker — Configuration
# Copy this file to .env and adjust the values.
# .env is NOT committed to Git (listed in .gitignore).

# ── Database ───────────────────────────────────────────────────────────────────
# Path to the SQLite database (written by the bot)
# DB_PATH=/absolute/path/to/fights.db

# ── Web Output ────────────────────────────────────────────────────────────────
# Path to data.json — on the server, point this to the web server folder
# Local (default): auto-detected relative to project root
# Server example:  /var/www/fair-fights/data.json
# JSON_PATH=/var/www/fair-fights/data.json

# ── Export Behaviour ──────────────────────────────────────────────────────────
# Push to Git after each export (true/false)
# Set to false on your own server — no Git needed
# GIT_PUSH=true

# Export interval in seconds (default: 300 = 5 minutes)
# EXPORT_INTERVAL=300

# ── ELO System ────────────────────────────────────────────────────────────────
# Start date of the first ELO season (format: YYYY-MM-DD)
# ELO_START_DATE=2026-06-01

# Minimum fights required to appear in the ranking
# ELO_MIN_FIGHTS=10

# Starting ELO for all players
# ELO_DEFAULT=1500

# Season duration in months (reset interval)
# ELO_RESET_MONTHS=3
