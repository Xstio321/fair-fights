# DAoC Fair Fights Tracker — Export Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an.
# .env wird NICHT in Git eingecheckt (steht in .gitignore).

# ── Datenbank ──────────────────────────────────────────────────────────────────
# Pfad zur SQLite-Datenbank (wird vom Bot befüllt)
# DB_PATH=/absolute/path/to/fights.db

# ── Web-Output ────────────────────────────────────────────────────────────────
# Pfad zu data.json — auf dem Server auf den Webserver-Ordner setzen
# Lokal (Standard): ../web/data.json
# Server-Beispiel: /var/www/fair-fights/data.json
# JSON_PATH=/var/www/fair-fights/data.json

# ── Export-Verhalten ──────────────────────────────────────────────────────────
# Git-Push nach jedem Export (true/false)
# Auf dem eigenen Server auf false setzen — kein Git mehr nötig
# GIT_PUSH=true

# Export-Intervall in Sekunden (Standard: 300 = 5 Minuten)
# EXPORT_INTERVAL=300

# ── ELO-System ────────────────────────────────────────────────────────────────
# Startdatum der ersten ELO-Season (Format: YYYY-MM-DD)
# ELO_START_DATE=2026-06-01

# Mindest-Fights um in der Rangliste zu erscheinen
# ELO_MIN_FIGHTS=10

# Start-ELO für alle Spieler
# ELO_DEFAULT=1500

# Dauer einer Season in Monaten (Reset-Rhythmus)
# ELO_RESET_MONTHS=3
